{
  "nombre": "postgres",
  "titulo": "PostgreSQL",
  "capa": "datos",
  "reconoce": [
    "postgresql",
    "postgres"
  ],
  "servicios": {
    "db": "Base de datos (PostgreSQL)"
  },
  "variables": {
    "DB_NAME": "{{nombre_bd}}",
    "DB_USER": "app",
    "DB_PASSWORD": "{{secreto:hex:16}}"
  },
  "carpeta": "database",
  "bd": {
    "servicio": "db",
    "modo": "servicio",
    "rls": false,
    "conexion": { "usuario": "${DB_USER}", "baseDatos": "${DB_NAME}" }
  }
}
